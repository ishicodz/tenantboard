# Copy to .env for local development
DATABASE_URL="postgresql://pm:pm@localhost:5432/pm?schema=public"
JWT_SECRET="change-me-to-a-long-random-string"
PORT=4000
CORS_ORIGIN="http://localhost:5173"
APP_URL="http://localhost:5173"
UPLOAD_DIR="./uploads"

# Background jobs: "bullmq" (Redis + `npm run dev:worker`) or "inline" (no Redis needed)
JOBS_MODE="bullmq"
REDIS_URL="redis://localhost:6379"

# Stripe test mode (https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_PRO=""
STRIPE_PRICE_BUSINESS=""

# Lets owners switch plans without Stripe in local demos. Never enable in production.
ALLOW_DEV_BILLING="true"
# Allow webhooks to http://localhost etc. (defaults to true outside production)
WEBHOOK_ALLOW_PRIVATE="true"
