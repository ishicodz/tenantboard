{
  "name": "@collab/server",
  "version": "1.0.0",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx --env-file-if-exists=.env prisma/seed.ts",
    "loadtest": "tsx scripts/loadtest.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "lib0": "^0.2.120",
    "prisma": "^6.19.3",
    "ws": "^8.23.0",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.33",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.6",
    "@types/supertest": "^7.2.1",
    "@types/ws": "^8.18.2",
    "@vitest/coverage-v8": "^3.2.7",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^3.2.7",
    "y-websocket": "^3.1.0"
  },
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  }
}
